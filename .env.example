# Copy this to .env for local dev, or set these in your deployment platform's
# environment variable settings. Never commit the real .env file.

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase service_role key (Project Settings -> API -> service_role)
# Full DB access, bypasses RLS. Server-only -- never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Passphrase gating the entire /admin area. Also doubles as the JWT signing
# secret (see SUPABASE_MIGRATION.md) -- use a long, random value, not a
# dictionary word, before deploying anywhere real.
ADMIN_SECRET_PASSPHRASE=

# URL of a self-hosted Piston code execution instance, used for the coding
# round's Python/Java/C/C++ options (JavaScript keeps running in-process,
# unchanged). The public Piston API is whitelist-only as of 2026-02-15, so
# this must point at your own instance. Requires a Docker-capable host
# (Railway/Render/self-host -- not serverless-only platforms like Netlify).
# See src/lib/pistonExecute.ts for the exact setup/package-install steps.
PISTON_API_URL=http://localhost:2000
