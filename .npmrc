# Belt-and-suspenders alongside pinning @types/node to satisfy vitest's peer
# range directly: some peer chains (transitive deps of msw, brought in by
# vitest) can still disagree in ways a version bump alone won't cover.
# Without this, `npm install` on a platform that doesn't default to
# --legacy-peer-deps (Railway's Railpack build does not) hard-fails on any
# such conflict instead of just installing -- which is exactly what broke
# the 2026-09-07 deploy.
legacy-peer-deps=true
